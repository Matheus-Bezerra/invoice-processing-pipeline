# Valores locais de exemplo, claramente fictícios. Copie para .env: cp .env.example .env
POSTGRES_DB=invoice
POSTGRES_USER=invoice
POSTGRES_PASSWORD=invoice_dev_only

RABBITMQ_USER=invoice
RABBITMQ_PASSWORD=invoice_dev_only

# Segredo compartilhado entre o invoice-webhook e o simulador do provedor (HMAC-SHA256 do callback). Só local.
WEBHOOK_HMAC_SECRET=webhook_dev_only_secret

# Para onde o worker manda a solicitação e para onde o simulador manda o callback (nomes dos serviços no Compose).
PROVIDER_BASE_URL=http://provider-simulator:8083
WEBHOOK_URL=http://invoice-webhook:8082
